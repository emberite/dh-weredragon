<div class="dh-weredragon-chat reading">
    <img class="wd-chat-art" src="{{art}}" alt="" />
    <h3>{{localize "DHWD.Sky.ChatTitle"}}</h3>
    <ol>
        {{#each items}}
        <li><i class="{{icon}}"></i><span><em>{{label}}</em><strong>{{name}}</strong></span></li>
        {{/each}}
    </ol>
    <p class="wd-chat-link">{{{link}}}</p>
</div>
